[Unit]
Description=free_proxy - local IP proxy gateway (aggregate pinzan/kuaidaili/juliang/...)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/free_proxy
EnvironmentFile=/opt/free_proxy/free_proxy.env
ExecStart=/opt/free_proxy/.venv/bin/python -m free_proxy -c /opt/free_proxy/config.yaml
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target